# Local MongoDB default. Replace with your MongoDB Atlas connection string if needed.
MONGODB_URI=mongodb://127.0.0.1:27017/make-my-marriage
MONGODB_DB_NAME=make-my-marriage

# Origin used to create shareable wedding invitation links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local development captures invitation emails in a mock provider (no delivery).
# Use EMAIL_PROVIDER=resend and add the values below for real delivery.
EMAIL_PROVIDER=mock
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Set to true when the app is served over HTTPS in production.
COOKIE_SECURE=false
